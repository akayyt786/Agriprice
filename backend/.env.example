# Copy this file to .env and fill in your values.
# .env is gitignored – never commit real credentials.

SECRET_KEY=django-insecure-replace-me-in-production
DEBUG=True

# Local SQLite is used automatically when DATABASE_URL is unset.
# For Railway PostgreSQL, paste the public URL from the Railway dashboard:
# DATABASE_URL=postgresql://postgres:<password>@<proxy>.proxy.rlwy.net:<port>/railway

# Cloudinary (optional for local dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional for local dev)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google OAuth (optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Government data API key
GOV_API_KEY=

# Frontend URL for CORS (optional, only needed for local frontend dev)
FRONTEND_URL=http://localhost:5500
